<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexMicroPresets</AssemblyName>
    <ApplicationIcon>assets\codex-micro-presets.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Editor\**\*.cs" />
    <Page Remove="Editor\**\*.xaml" />
    <ApplicationDefinition Remove="Editor\**\*.xaml" />
    <EmbeddedResource Remove="Editor\**\*" />
    <None Remove="Editor\**\*" />
    <Content Include="assets\codex-micro-presets.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
