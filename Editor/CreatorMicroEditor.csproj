<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType><RootNamespace>CreatorMicroEditor</RootNamespace>
    <UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationTitle>Creator Micro Model Keys</ApplicationTitle>
    <ApplicationId>com.lancelarsen.creatormicromodelkeys</ApplicationId>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion><ApplicationVersion>2</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion><TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <Compile Include="..\Presets.cs" Link="Shared\Presets.cs" />
    <Compile Include="..\EditorProtocol.cs" Link="Shared\EditorProtocol.cs" />
    <Compile Include="..\EditorDraft.cs" Link="Shared\EditorDraft.cs" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <Content Include="..\assets\codex-micro-presets.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>